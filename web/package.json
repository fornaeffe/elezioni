{
  "name": "elezioni-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:data": "tsc -p tsconfig.preparation.json",
    "data:download": "tsx --tsconfig tsconfig.json scripts/data-preparation/cli.ts download",
    "data:import": "tsx --tsconfig tsconfig.json scripts/data-preparation/cli.ts import",
    "data:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/cli.ts generate",
    "data:polls:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/polls-cli.ts generate",
    "data:polls:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/polls-cli.ts check",
    "data:reform:download": "tsx --tsconfig tsconfig.json scripts/data-preparation/reform-cli.ts download",
    "data:reform:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/reform-cli.ts generate",
    "data:reform:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/reform-cli.ts check",
    "data:reform:validate": "tsx --tsconfig tsconfig.json scripts/data-preparation/reform-validation.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:results": "playwright test --config playwright.results.config.ts",
    "acceptance:reform": "tsx --tsconfig tsconfig.json scripts/acceptance/reform.ts",
    "benchmark:politics": "playwright test --config playwright.benchmark.config.ts politics-worker.spec.ts",
    "benchmark:reform": "playwright test --config playwright.benchmark.config.ts reform-workers.spec.ts --workers=1",
    "benchmark:regional-er": "playwright test --config playwright.benchmark.config.ts regional-er-worker.spec.ts",
    "data:polls:references": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-references-cli.ts",
    "data:polls:calibration:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-calibration-cli.ts check",
    "data:polls:calibration:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-calibration-cli.ts generate",
    "data:polls:calibration:download": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-calibration-cli.ts download",
    "data:polls:calibration:verify-results": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-calibration-cli.ts verify-results",
    "data:polls:calibration:freeze-results": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-calibration-cli.ts freeze-results",
    "data:polls:uncertainty:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-uncertainty-cli.ts check",
    "data:polls:uncertainty:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/poll-uncertainty-cli.ts generate",
    "data:forecast:history:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-history-cli.ts check",
    "data:forecast:history:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-history-cli.ts generate",
    "data:forecast:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-study-cli.ts check",
    "data:forecast:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-study-cli.ts generate",
    "data:forecast:six:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-six-category-cli.ts check",
    "data:forecast:six:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/generation-six-category-cli.ts generate",
    "data:forecast:drift:check": "tsx --tsconfig tsconfig.json scripts/data-preparation/drift-study-cli.ts check",
    "data:forecast:drift:generate": "tsx --tsconfig tsconfig.json scripts/data-preparation/drift-study-cli.ts generate",
    "data:forecast:drift:compare": "tsx --tsconfig tsconfig.json scripts/data-preparation/drift-comparison-cli.ts",
    "data:forecast:drift:validate": "tsx --tsconfig tsconfig.json scripts/data-preparation/drift-bayesian-check.ts",
    "data:forecast:party:validate": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-research-cli.ts validate",
    "data:forecast:party:profile": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-research-cli.ts profile",
    "data:forecast:party:restricted": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-restricted-cli.ts",
    "data:forecast:party:importance": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-importance-stress-cli.ts",
    "data:forecast:party:memberships": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-memberships-cli.ts generate",
    "data:forecast:party:cutoffs": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-cutoff-audit-cli.ts",
    "data:forecast:party:panels": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-panel-cli.ts",
    "data:forecast:party:stan:prepare": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-stan-export-cli.ts",
    "data:forecast:party:real:prepare": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-real-export-cli.ts",
    "data:forecast:share:prepare": "tsx --tsconfig tsconfig.json scripts/data-preparation/party-drift-modular-export-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "25.9.1",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "read-excel-file": "9.3.12",
    "svelte": "5.56.0",
    "svelte-check": "4.4.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.0.15",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@lucide/svelte": "1.17.0"
  }
}
